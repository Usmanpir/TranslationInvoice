# ───────────────────────── InvoiceFlow environment ─────────────────────────
# Copy to .env.local for local development (npm run db:* scripts read .env.local).
# In Vercel, set these under Settings → Environment Variables. Never commit real values.

# ── Required ──────────────────────────────────────────────────────────────
# PostgreSQL connection string.
DATABASE_URL="postgresql://invoiceflow:invoiceflow@localhost:55432/invoiceflow?schema=public"
# Session signing secret. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""
# Public URL of the app (no trailing slash). Leave unset on Vercel to use the deployment URL.
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="InvoiceFlow"

# ── Billing: Stripe (card payments) ──────────────────────────────────────
# Leave empty to disable card payments. Prices are created automatically from src/lib/plans.ts.
STRIPE_SECRET_KEY=""
# From the Stripe dashboard webhook endpoint pointing at /api/billing/webhook/stripe
# (events: checkout.session.completed, customer.subscription.*, invoice.paid, invoice.payment_failed)
STRIPE_WEBHOOK_SECRET=""

# ── Billing: manual bank transfer ────────────────────────────────────────
# "false" hides the bank-transfer option. Requests are confirmed in /saas-admin/billing.
MANUAL_BILLING_ENABLED="true"
# Shown to customers who choose bank transfer (bank name, IBAN, beneficiary…).
MANUAL_BILLING_INSTRUCTIONS=""

# ── Email: Resend ─────────────────────────────────────────────────────────
# Without an API key, emails are printed to the server console instead of being sent.
RESEND_API_KEY=""
EMAIL_FROM="InvoiceFlow <billing@yourdomain.com>"
# Where contact-form messages are delivered.
SUPPORT_EMAIL=""

# ── Scheduled jobs ───────────────────────────────────────────────────────
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/daily (see vercel.json).
CRON_SECRET=""

# ── Demo & seed (optional) ───────────────────────────────────────────────
ADMIN_EMAIL="admin@invoiceflow.com"
# Leave empty to generate a random admin password (printed once by the seed).
ADMIN_PASSWORD=""
DEMO_PASSWORD="demo123456"
DEMO_ORGANIZATION_ID="org_demo_company"
DEMO_USER_EMAILS="demo@invoiceflow.com,sales@invoiceflow.com,accounts@invoiceflow.com"
