// prisma/schema.prisma
//
// Multi-tenant model: every business is an Organization. Users join organizations
// through Membership (with a role). All tenant-owned records carry `organizationId`
// and every query must be scoped by it (see src/lib/server/context.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Identity ───────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  phone         String?
  // Platform (SaaS owner) access. Completely separate from organization roles.
  isSuperAdmin  Boolean   @default(false)
  // Incremented to invalidate every existing session ("log out everywhere").
  tokenVersion  Int       @default(0)
  emailVerified DateTime?
  // Last organization the user worked in; validated against memberships on every request.
  lastOrganizationId String?
  locale        String    @default("en")
  timezone      String    @default("Asia/Dubai")
  dateFormat    String    @default("MMM dd, yyyy")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships        Membership[]
  customers          Customer[]
  invoices           Invoice[]
  quotations         Quotation[]
  uploads            Upload[]
  invitationsSent    Invitation[]     @relation("InvitedBy")
  paymentsRecorded   Payment[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────────── Organizations ─────────────────────────────

model Organization {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  status    OrganizationStatus @default(ACTIVE)

  // Company profile / branding
  email        String?
  phone        String?
  website      String?
  address      String?
  country      String  @default("AE")
  logoUploadId String?
  primaryColor String  @default("#0070c7")

  // Tax
  taxNumber      String?              // VAT / TRN
  taxLabel       String  @default("VAT")
  defaultTaxRate Float   @default(5)
  taxInclusive   Boolean @default(false)

  // Banking / payment instructions (printed on invoices)
  bankName            String?
  bankBranch          String?
  bankAccountName     String?
  bankAccountNumber   String?
  iban                String?
  swiftCode           String?
  paypalEmail         String?
  paymentInstructions String?

  // Invoice & quotation preferences
  defaultCurrency     String @default("AED")
  invoicePrefix       String @default("INV")
  quotationPrefix     String @default("QUO")
  invoiceNextNumber   Int    @default(1)
  quotationNextNumber Int    @default(1)
  numberPadding       Int    @default(4)
  paymentTermsDays    Int    @default(30)
  defaultNotes        String?
  invoiceFooter       String?

  // Locale
  timezone   String @default("Asia/Dubai")
  dateFormat String @default("MMM dd, yyyy")

  onboardingCompletedAt DateTime?
  suspendedAt           DateTime?
  suspendedReason       String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  memberships     Membership[]
  invitations     Invitation[]
  subscription    Subscription?
  billingPayments BillingPayment[]
  billingEvents   BillingEvent[]
  customers       Customer[]
  invoices        Invoice[]
  quotations      Quotation[]
  payments        Payment[]
  uploads         Upload[]
  notifications   Notification[]
  auditLogs       AuditLog[]

  @@index([status])
  @@index([createdAt])
}

model Membership {
  id                String         @id @default(cuid())
  userId            String
  organizationId    String
  role              MembershipRole @default(SALES)
  // Per-member notification preferences: { [type]: { inApp: boolean, email: boolean } }
  notificationPrefs Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Invitation {
  id             String         @id @default(cuid())
  organizationId String
  email          String
  role           MembershipRole @default(SALES)
  // Only the SHA-256 hash of the token is stored; the raw token is emailed once.
  tokenHash      String         @unique
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([email])
}

// ─────────────────────────────── Billing ───────────────────────────────

model Subscription {
  id                     String             @id @default(cuid())
  organizationId         String             @unique
  // Plan key from src/lib/plans.ts (free | starter | professional | business)
  plan                   String             @default("free")
  interval               BillingInterval    @default(MONTH)
  status                 SubscriptionStatus @default(TRIALING)
  trialStart             DateTime?
  trialEnd               DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?
  provider               BillingProviderId  @default(NONE)
  providerCustomerId     String?
  providerSubscriptionId String?            @unique
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([plan])
  @@index([trialEnd])
}

// A charge for the SaaS subscription itself (billing history).
model BillingPayment {
  id             String            @id @default(cuid())
  organizationId String
  provider       BillingProviderId
  providerRef    String?           @unique
  plan           String
  interval       BillingInterval
  amount         Float
  currency       String            @default("AED")
  status         BillingPaymentStatus
  description    String?
  receiptUrl     String?
  periodStart    DateTime?
  periodEnd      DateTime?
  paidAt         DateTime?
  createdAt      DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// Raw provider webhook / admin billing events, stored for idempotency and auditing.
model BillingEvent {
  id             String            @id @default(cuid())
  provider       BillingProviderId
  eventId        String            @unique
  type           String
  organizationId String?
  payload        Json
  processedAt    DateTime?
  error          String?
  createdAt      DateTime          @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

// ─────────────────────────────── Business data ───────────────────────────────

model Upload {
  id             String        @id @default(cuid())
  organizationId String
  purpose        UploadPurpose @default(PAYMENT_PROOF)
  filename       String
  mimeType       String
  size           Int
  data           Bytes
  checksum       String?
  userId         String?
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([checksum])
}

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String
  phone          String?
  address        String?
  company        String?
  taxNumber      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  // Creator. Kept nullable so removing a team member never deletes business data.
  userId         String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  invoices     Invoice[]
  quotations   Quotation[]

  @@index([organizationId, createdAt])
  @@index([organizationId, name])
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  invoiceNumber  String
  status         InvoiceStatus @default(PENDING)
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  notes          String?
  paymentProof   String?
  // Snapshotted at creation; never re-derived from organization settings.
  currency       String        @default("AED")
  salesperson    String?
  completionDays String?
  taxRate        Float         @default(0)
  taxInclusive   Boolean       @default(false)
  discount       Float         @default(0)
  subtotal       Float         @default(0)
  taxAmount      Float         @default(0)
  discountAmount Float         @default(0)
  total          Float         @default(0)
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  userId         String?
  customerId     String
  quotationId    String?       @unique

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotation    Quotation?    @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  items        InvoiceItem[]
  payments     Payment[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status])
  @@index([organizationId, issueDate])
  @@index([organizationId, dueDate])
  @@index([customerId])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  code        String?
  description String
  quantity    Float
  unitPrice   Float
  total       Float
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// A payment received against an invoice.
model Payment {
  id             String        @id @default(cuid())
  organizationId String
  invoiceId      String
  amount         Float
  currency       String
  method         PaymentMethod @default(BANK_TRANSFER)
  reference      String?
  notes          String?
  proofUrl       String?
  paidAt         DateTime      @default(now())
  recordedById   String?
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy   User?        @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([organizationId, paidAt])
  @@index([invoiceId])
}

model Quotation {
  id                 String          @id @default(cuid())
  organizationId     String
  quotationNumber    String
  status             QuotationStatus @default(DRAFT)
  issueDate          DateTime        @default(now())
  validUntil         DateTime
  notes              String?
  currency           String          @default("AED")
  salesperson        String?
  completionDays     String?
  taxRate            Float           @default(0)
  taxInclusive       Boolean         @default(false)
  discount           Float           @default(0)
  subtotal           Float           @default(0)
  taxAmount          Float           @default(0)
  discountAmount     Float           @default(0)
  total              Float           @default(0)
  convertedToInvoice Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  userId             String?
  customerId         String

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer     Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items        QuotationItem[]
  invoice      Invoice?

  @@unique([organizationId, quotationNumber])
  @@index([organizationId, status])
  @@index([organizationId, issueDate])
  @@index([customerId])
}

model QuotationItem {
  id          String    @id @default(cuid())
  code        String?
  description String
  quantity    Float
  unitPrice   Float
  total       Float
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

// ─────────────────────────── Activity & messaging ───────────────────────────

model Notification {
  id             String   @id @default(cuid())
  organizationId String
  // null = visible to every member of the organization
  userId         String?
  type           String
  title          String
  body           String?
  link           String?
  readAt         DateTime?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, createdAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  // null for platform-level (SaaS admin) events
  organizationId String?
  userId         String?
  action         String
  entityType     String?
  entityId       String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([action])
}

// Fixed-window rate limiting shared across serverless instances.
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

// ─────────────────────────────── Enums ───────────────────────────────

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipRole {
  OWNER
  ADMIN
  ACCOUNTANT
  SALES
  VIEWER
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  SUSPENDED
}

enum BillingInterval {
  MONTH
  YEAR
}

enum BillingProviderId {
  NONE
  STRIPE
  MANUAL
}

enum BillingPaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum UploadPurpose {
  PAYMENT_PROOF
  LOGO
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CHEQUE
  CARD
  PAYPAL
  OTHER
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  CONVERTED
}
